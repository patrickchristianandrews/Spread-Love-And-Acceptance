{
  "name": "quicksilver",
  "productName": "Quicksilver",
  "version": "2.20.7",
  "description": "Quicksilver: forms to fit your work. Private AI on your own PC: multi-model stacks, fact checking, knowledge bases, a photo & video studio and an OpenAI-compatible API.",
  "main": "src/main/main.js",
  "author": {
    "name": "Patrick Christian Andrews"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/backend.test.js && node test/media-catalog.test.js && node test/loading.test.js && node test/skills-auto.test.js && node test/pro.test.js && node test/fixes.test.js && node test/plugins.test.js && node test/torrents.test.js && node test/giant.test.js && node test/safesearch.test.js && node scripts/api-directory.js --check && node test/ui.test.js && node test/liquid-picture.test.js",
    "fetch-engines": "node scripts/fetch-engines.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "docx": "^9.15.2",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "hyparquet": "^1.33.0",
    "mammoth": "^1.13.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "unpdf": "^1.9.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.liquid.quicksilver",
    "productName": "Quicksilver",
    "copyright": "Copyright © 2026 Patrick Christian Andrews",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "data/models.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Quicksilver-Setup-${version}.${ext}",
      "legalTrademarks": "Quicksilver",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quicksilver",
      "runAfterFinish": true,
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Quicksilver",
      "menuCategory": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "starter",
        "to": "starter",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "homepage": "https://github.com/patrickchristianandrews/Spread-Love-And-Acceptance"
}
