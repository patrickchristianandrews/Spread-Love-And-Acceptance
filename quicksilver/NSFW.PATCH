+// Pictures for the chat: SearXNG's image engines, or Brave's image endpoint with a key.
+// Returns { title, url, thumb } and never throws for one bad item.
+async function images(query, { count = 8 } = {}) {
+  const cfg = store.config().web;
+  const n = Math.min(12, Math.max(1, Number(count) || 8));
+  if (cfg.provider === 'brave') {
+    const key = store.getSecret('web:brave');
+    if (!key) throw new Error('Add your Brave Search key in Settings → Web search.');
+    const res = await fetch(`https://api.search.brave.com/res/v1/images/search?count=${n}&safesearch=${safeWord()}&q=${encodeURIComponent(query)}`, { headers: { Accept: 'application/json', 'X-Subscription-Token': key }, signal: AbortSignal.timeout(15000) });
+    if (!res.ok) throw new Error(`Brave Images returned HTTP ${res.status}.`);
+    const j = await res.json();
+    return (j.results || []).map((r) => ({ title: r.title || '', url: r.properties?.url || r.url, thumb: r.thumbnail?.src || r.thumbnail?.url })).filter((r) => r.url);
+  }
+  if (cfg.provider === 'searxng') {
+    if (!cfg.searxngUrl) throw new Error('Add your SearXNG address in Settings → Web search.');
+    const base = cfg.searxngUrl.replace(/\/+$/, '');
+    const res = await fetch(`${base}/search?format=json&categories=images&safesearch=${safeOff() ? 0 : 1}&q=${encodeURIComponent(query)}`, { signal: AbortSignal.timeout(20000) });
+    if (!res.ok) throw new Error(`SearXNG returned HTTP ${res.status}.`);
+    const j = await res.json();
+    // With image_proxy on, SearXNG hands back a relative /image_proxy?url=… address.
+    const abs = (u) => (!u ? '' : /^https?:\/\//.test(u) ? u : `${base}${u.startsWith('/') ? '' : '/'}${u}`);
+    const seen = new Set();
+    return (j.results || []).map((r) => ({ title: r.title || '', url: abs(r.img_src || r.thumbnail_src), thumb: abs(r.thumbnail_src) }))
+      .filter((r) => r.url && !seen.has(r.url) && seen.add(r.url)).slice(0, n);
+  }
+  throw new Error('Picture results need SearXNG or a Brave key (Settings → Web search). The free DuckDuckGo search has no pictures.');
+}
