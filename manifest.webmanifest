{
  "name": "Spread Love & Acceptance",
  "short_name": "Spread Love & Acceptance",
  "description": "Free, calm, practical tools for understanding yourself and the people you love. No sign-up. What you type stays on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F5EFDE",
  "theme_color": "#F5EFDE",
  "icons": [
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/apple-touch-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Today’s Weather",
      "short_name": "Weather",
      "url": "/quick-checks.html",
      "icons": [
        {
          "src": "/assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Upset right now?",
      "short_name": "Upset now",
      "url": "/upset-right-now.html",
      "icons": [
        {
          "src": "/assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Share the load",
      "short_name": "Share load",
      "url": "/share-the-load.html",
      "icons": [
        {
          "src": "/assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "The Night Garden",
      "short_name": "Garden",
      "url": "/night-garden.html",
      "icons": [
        {
          "src": "/assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "orientation": "portrait",
  "categories": [
    "health",
    "lifestyle",
    "education"
  ],
  "display_override": [
    "standalone"
  ],
  "screenshots": [
    {
      "src": "/store/google-play/screenshots/2-night-garden.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Night Garden: breathe, play and let your mind settle"
    },
    {
      "src": "/store/google-play/screenshots/4-breathe.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "A calming breathing break with soft sound"
    },
    {
      "src": "/store/google-play/screenshots/5-turning-toward.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Today’s small moment to feel closer to someone"
    },
    {
      "src": "/store/google-play/screenshots/6-conversation-reader.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Conversation Reader"
    },
    {
      "src": "/store/google-play/screenshots/wide-night-garden.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Night Garden"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://spreadloveandacceptance.com/manifest.webmanifest"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "share_target": {
    "action": "/signal-translator.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
